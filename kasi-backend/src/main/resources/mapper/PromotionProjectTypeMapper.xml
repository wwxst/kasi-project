<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kasi.backend.promotion.mapper.PromotionProjectTypeMapper">
    <resultMap id="PromotionProjectTypeMap" type="com.kasi.backend.promotion.entity.PromotionProjectType">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="status" property="status"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findAll" resultMap="PromotionProjectTypeMap">
        SELECT * FROM promotion_project_type ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findById" resultMap="PromotionProjectTypeMap">
        SELECT * FROM promotion_project_type WHERE id = #{id}
    </select>

    <select id="findByIdForUpdate" resultMap="PromotionProjectTypeMap">
        SELECT * FROM promotion_project_type WHERE id = #{id} FOR UPDATE
    </select>

    <select id="findByCode" resultMap="PromotionProjectTypeMap">
        SELECT * FROM promotion_project_type WHERE code = #{code}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO promotion_project_type (code, name, status, sort_order)
        VALUES (#{code}, #{name}, #{status}, #{sortOrder})
    </insert>

    <update id="update">
        UPDATE promotion_project_type
        SET code = #{code},
            name = #{name},
            status = #{status},
            sort_order = #{sortOrder},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM promotion_project_type WHERE id = #{id}
    </delete>
</mapper>
